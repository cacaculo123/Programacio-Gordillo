n1 = input("Pon un numero\n")
n2 = input("Pon otro numero\n")

if n1.replace("-", "", 1).replace(".", "", 1).isdigit() and n2.replace("-", "", 1).replace(".", "", 1).isdigit():
    n1 = int(n1)
    n2 = int(n2)
    operacion = input("Que operacion quieres hacer? (suma, resta, multiplicacion, division, division entera, potencia, modulo)\n")


    #Suma
    if operacion == "suma":
        print("La suma de los dos numeros es:", n1+n2)

    #Resta
    elif operacion == "resta":
       resta = input(f"Quieres hacer {n1} - {n2} o al revés? (así: 1 o al réves: 2)\n")
       if resta == "1":
           print("La resta de los dos numeros es:", n1-n2)
       elif resta == "2":
           print("La resta de los dos numeros es:", n2-n1)
       else:
           print("Opción no válida")
           
    #Multiplicación
    elif operacion == "multiplicacion":
        print("La multiplicacion de los dos numeros es:", n1*n2)

    #Division
    elif operacion == "division":
        divison = input(f"Quieres hacer {n1} / {n2} o al revés? (así: 1 o al réves: 2)\n")
        if divison == "1":
            if n1 == 0 or n2 == 0:
                print("Los números deben ser positivos")
            else:
                print("La division de los dos numeros es:", n1/n2)
        elif divison == "2":
            aux = n1
            n1 = n2
            n2 = aux
            if n1 == 0 or n2 == 0:
                print("Los números deben ser positivos")
            else:
                print("La division de los dos numeros es:", n1/n2)
        else:
            print("Opción no válida")

    #Division entera
    elif operacion == "division entera":
        divison_entera = input(f"Quieres hacer {n1} // {n2} o al revés? (así: 1 o al réves: 2)\n")
        if divison_entera == "1":
            if n1 == 0 or n2 == 0:
                print("Los números deben ser positivos")
            else:
                print("La division entera de los dos numeros es:", n1//n2)
        elif divison_entera == "2":
            aux = n1
            n1 = n2
            n2 = aux
            if n1 == 0 or n2 == 0:
                print("Los números deben ser positivos")
            else:
                print("La division entera de los dos numeros es:", n1//n2)
        else:
            print("Opción no válida")

    #Potencia
    elif operacion == "potencia":
            potencia = input(f"Quieres hacer {n1} ^ {n2} o al revés? (así: 1 o al réves: 2)\n")
            if potencia == "1":
                    if n1 == 0 and n2 <= 0:
                        print("No se puede hacer la potencia")
                    else:
                        print("La potencia de los dos numeros es:", n1**n2)
            elif potencia == "2":
                    aux = n1
                    n1 = n2
                    n2 = aux
                    if n1 == 0 and n2 <= 0:
                        print("No se puede hacer la potencia")
                    else:
                        print("La potencia de los dos numeros es:", n2**n1)
            else:
                print("Opción no válida")

    #Modulo
    elif operacion == "modulo":
        print("El modulo de los dos numeros es:", n1%n2)

    
else:
    print("Los valores introducidos no son correctos")
